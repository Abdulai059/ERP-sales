# Copy to .env. Never commit .env
NODE_ENV=development
PORT=3000
CONTROL_DATABASE_URL=postgres://postgres:dev@localhost:5432/control
# {db} is replaced with each business's database name
TENANT_DATABASE_URL_TEMPLATE=postgres://postgres:dev@localhost:5432/{db}
BASE_DOMAIN=localhost
JWT_SECRET=change-me-to-a-long-random-string
SESSION_TTL_MINUTES=480
